<Window x:Class="MatricsMC.LauncherImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Launcher - MatricsMC"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0D0F12"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- ACTION BUTTON                                         -->
        <!-- ===================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#57D66B"/>

            <Setter Property="Foreground"
                    Value="#08100A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20,11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#70E981"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#46BD59"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- SECONDARY BUTTON                                      -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#1A1D22"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#30353D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="16,9"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#23272D"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN                                                      -->
    <!-- ========================================================= -->

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER                                                  -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Import Launcher"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Bring your existing Minecraft data into MatricsMC."
                       Foreground="#777C85"
                       FontSize="14"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- DETECTION                                              -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="#15181D"
                BorderBrush="#23272E"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,25,0,15"
                Padding="18">

            <Grid>

                <StackPanel>

                    <TextBlock Text="Launcher Detection"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ScanStatusText"
                               Text="Ready to scan your computer."
                               Foreground="#777C85"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Button Content="Scan Again"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        Click="ScanButton_Click"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- LAUNCHER LIST                                          -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel x:Name="LauncherList"
                        Margin="0,0,0,10"/>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- IMPORT PROGRESS                                        -->
        <!-- ===================================================== -->

        <Border x:Name="ImportProgressPanel"
                Grid.Row="2"
                Background="#15181D"
                BorderBrush="#292E35"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Visibility="Collapsed">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Importing Data"
                           FontSize="21"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ImportCurrentItemText"
                           Text="Preparing..."
                           FontSize="12"
                           Foreground="#777C85"
                           Margin="0,6,0,20"/>


                <!-- PROGRESS BAR -->

                <ProgressBar x:Name="ImportProgressBar"
                             Height="9"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>


                <!-- PERCENTAGE -->

                <Grid Margin="0,10,0,0">

                    <TextBlock Text="Import Progress"
                               FontSize="11"
                               Foreground="#777C85"/>

                    <TextBlock x:Name="ImportPercentText"
                               Text="0%"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>

                </Grid>


                <TextBlock x:Name="ImportDetailsText"
                           Text="Starting..."
                           FontSize="11"
                           Foreground="#5F646D"
                           Margin="0,14,0,0"/>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTTOM                                                 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="3"
              Margin="0,15,0,0">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Selected: "
                           Foreground="#777C85"/>

                <TextBlock x:Name="SelectedCountText"
                           Text="0"
                           FontWeight="SemiBold"/>

            </StackPanel>


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="ImportButton"
                        Content="Import Selected"
                        Style="{StaticResource ActionButton}"
                        Click="ImportButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
