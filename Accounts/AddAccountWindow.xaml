<Window x:Class="MatricsMC.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Offline Profile"
        Width="460"
        Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0F12"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="ButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#181B20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#292E35"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonStyle}">

            <Setter Property="Background"
                    Value="#57D66B"/>

            <Setter Property="Foreground"
                    Value="#08100A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Add Offline Profile"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="Create a local development profile."
                       Foreground="#777C85"
                       FontSize="12"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="#15181D"
                BorderBrush="#252A31"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,24,0,20">

            <StackPanel>

                <TextBlock Text="USERNAME"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#626771"
                           Margin="0,0,0,8"/>

                <Border Height="44"
                        Background="#101216"
                        BorderBrush="#292E35"
                        BorderThickness="1"
                        CornerRadius="8">

                    <TextBox x:Name="UsernameTextBox"
                             Margin="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             MaxLength="16"/>

                </Border>

                <TextBlock Text="Letters, numbers, and underscores only."
                           FontSize="11"
                           Foreground="#626771"
                           Margin="2,7,0,0"/>

            </StackPanel>

        </Border>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Cancel"
                    Width="100"
                    Height="40"
                    Style="{StaticResource ButtonStyle}"
                    Click="Cancel_Click"/>

            <Button Grid.Column="3"
                    Content="Add Account"
                    Width="120"
                    Height="40"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click"/>

        </Grid>

    </Grid>

</Window>
